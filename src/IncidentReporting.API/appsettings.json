{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "ReverseProxy": {
    "Enabled": false,
    "ForwardLimit": 1
  },
  "Jwt": {
    "Key": "",
    "Issuer": "IncidentReportingAPI",
    "Audience": "IncidentReportingUsers",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "n8n": {
    "WebhookUrl": "https://your-n8n-instance.com/webhook/incident-created",
    "IsEnabled": false,
    "SkipNotifyForEmailOrigin": true
  },
  "EmailIntake": {
    "IsEnabled": false,
    "ApiKey": "",
    "SystemUserId": "00000000-0000-0000-0000-000000000000",
    "DefaultCategory": "Other",
    "DefaultPriority": "Medium"
  },
  "Ai": {
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "Endpoint": "https://api.openai.com/v1/chat/completions",
    "IsMockEnabled": true
  },
  "Smtp": {
    "IsMockEnabled": true,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@incidentreporting.local",
    "FromName": "Incident Reporting System"
  },
  "Attachments": {
    "StorageRoot": "App_Data/attachments",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".gif", ".pdf", ".txt", ".log", ".csv", ".docx", ".xlsx" ]
  }
}