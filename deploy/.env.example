# Copy to .env (never commit .env) and fill in every value marked REQUIRED.

# REQUIRED - public domain whose DNS A/AAAA record points to this server
DOMAIN=incidents.example.com
# Email for Let's Encrypt expiry notices (recommended)
ACME_EMAIL=admin@example.com

# REQUIRED - SQL Server "sa" password: 8+ chars with upper, lower, digit and symbol.
# Do not use ; or quotes (it is embedded in the connection string).
SQL_SA_PASSWORD=
DB_NAME=IncidentReportingDb
# Express is free (10 GB per database); use Standard/Enterprise only with a license
MSSQL_PID=Express

# REQUIRED - JWT signing key, at least 32 random characters, e.g.: openssl rand -base64 48
JWT_KEY=

# First Admin account, created only if no Admin exists yet. Remove both after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Outgoing email (password reset links). With SMTP_MOCK=true emails are only written to the API log.
SMTP_MOCK=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# For Gmail: a 16-letter app password, without spaces
SMTP_PASSWORD=
SMTP_FROM=

# Build the frontend from a local checkout instead of GitHub (path relative to this folder)
# WEB_CONTEXT=../../IncidentReportingFrontend
